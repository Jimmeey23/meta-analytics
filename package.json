{
  "name": "meta-insight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "next lint",
    "dev:port": "next dev -H 0.0.0.0 -p 3000",
    "check:creative": "node scripts/check-creative-mapping.mjs",
    "check:calls": "node scripts/check-call-budget.mjs",
    "check:limits": "node scripts/check-rate-limits.mjs",
    "check:intelligence": "node scripts/check-intelligence.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:creative && npm run check:calls && npm run check:limits && npm run check:intelligence"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.544.0",
    "next": "^15.5.25",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
